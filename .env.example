# Copy to .env and fill in. Never commit .env — it's gitignored.

# MySQL 8. The database must already exist; `npm run db:migrate` creates tables.
DATABASE_URL=mysql://watson:CHANGEME@127.0.0.1:3306/watson

# Admin password for /admin. There is no fallback — if this is unset, every
# admin request is rejected. Generate one:
#   node -e "console.log(require('crypto').randomBytes(9).toString('base64url'))"
ADMIN_CODE=

# Where uploaded photos are written. MUST live outside the repo: anything under
# public/ is part of the build and gets wiped on the next deploy.
# Defaults to ./uploads (gitignored) when unset, which is fine for local dev.
UPLOAD_DIR=/var/www/watson/uploads

# Optional
# DB_POOL_SIZE=10
